        "jsCode": "const resultado = $input.first().json;\nconst sessionId = $('Chat Trigger').first().json.sessionId;\n\nconst esNuevo = !resultado || Object.keys(resultado).length === 0 || !resultado.Usuario;\n\nreturn [{\n  json: {\n    es_nuevo: esNuevo,\n    Usuario: esNuevo ? sessionId : resultado.Usuario,\n    preferencias: esNuevo ? '' : resultado.preferencias,\n    tono_preferido: esNuevo ? '' : resultado.tono_preferido,\n    interaction_count: esNuevo ? 0 : resultado.interaction_count\n  }\n}];"
      },
