    {
      "parameters": {
        "jsCode": "const perfil = $('Perfil Consolidado').first().json;\nconst agente = $input.first().json; // salida del Asistente Personal\nconst sessionId = $('Chat Trigger').first().json.sessionId;\n\nconst conteo = Number(perfil.interaction_count || 0) + 1;\n\nreturn [{\n  json: {\n    Usuario: perfil.Usuario || sessionId,\n    preferencias: perfil.preferencias || 'Sin datos todavía.',\n    tono_preferido: perfil.tono_preferido || 'neutro',\n    interaction_count: conteo,\n    respuesta_asistente: agente.output || ''\n  }\n}];"
      },
